# ==============================================================================
# Darion Workforce Management System - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Credentials (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Supabase Server-Side Admin / Service Role Key (Required)
# ------------------------------------------------------------------------------
# CRITICAL: Keep secret! Used exclusively on the server (Server Actions & Route Handlers)
# Bypasses Row Level Security (RLS) for provisioning, administrative resets, and cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Application & Deployment URLs (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERIFY_APP_URL=https://your-verify-app.vercel.app

# ------------------------------------------------------------------------------
# 4. Darion Meet & Feature Flags (Optional / Beta Configuration)
# ------------------------------------------------------------------------------
# Enable Google Meet integration for all users (true/false)
NEXT_PUBLIC_ENABLE_MEETS_ALL=false

# Comma-separated list of candidate/admin emails granted beta access to Darion Meet
MEETS_BETA_ALLOWED_EMAILS=admin@example.com,user@example.com

# ------------------------------------------------------------------------------
# 5. Google Drive API Integration for Meeting Recordings (Optional)
# ------------------------------------------------------------------------------
# Service Account Approach (Option A - Recommended for Server-to-Server Sync)
# Provide either the entire JSON string or individual fields:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OAuth2 Refresh Token Approach (Option B)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Drive Target Folder ID where meeting recordings will be synced
GOOGLE_DRIVE_FOLDER_ID=
